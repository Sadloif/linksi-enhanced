<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      Enhanced modules. Every one of these is requested only when the user turns the matching
      optional feature on (specification section 33); none is needed for normal link saving.
      USE_EXACT_ALARM was removed: it is restricted to alarm/calendar apps and is unused by the code.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />


    <application
        android:name=".LinksApplication"
        android:allowBackup="true"
        android:icon="@mipmap/linksi"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/linksi_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Linksi"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:localeConfig="@xml/locales_config">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.App.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Share Activity - appears in Android share sheet -->
        <activity
            android:name=".ui.screens.ShareReceiverActivity"
            android:exported="true"
            android:label="Save to Linksi"
            android:theme="@style/Theme.Linksi.Transparent"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- WorkManager initialization -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <receiver android:name=".utils.ReminderReceiver"
            android:exported="false" />

        <!-- WorkManager runs long downloads in a foreground service. On API 34+ that service must
             declare its type, otherwise Android throws when the download starts. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!--
          OPTIONAL MODULE: smart link detection, accessibility service and floating bubble
          (specification sections 11, 12 and 33; research note ANDROID16_REQUIREMENTS.md sections 7
          and 8). Nothing below ever runs unless the user turns the matching feature on: there is no
          boot receiver, no auto-start and no clipboard access from any of it. Normal saving,
          sharing and browsing work identically with all three components absent or disabled.
        -->

        <!--
          The optional accessibility assistance. The system binds this service, so it must be
          exported, but BIND_ACCESSIBILITY_SERVICE means only the system (or a user who explicitly
          enables it in Settings) can ever bind it. `isAccessibilityTool` is deliberately not set:
          this is not a disability-support app, and claiming otherwise is a Play policy violation.
          `settingsActivity` is declared in the XML config so a user can jump back into Linksi.
        -->
        <service
            android:name=".enhanced.service.LinksiAccessibilityService"
            android:exported="true"
            android:label="@string/enhanced_accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
          The optional floating bubble. It is a foreground service because Android requires a
          visible notification for an overlay that outlives the app, and because Android 15 narrowed
          the SYSTEM_ALERT_WINDOW background-start exemption to apps with a *currently visible*
          overlay. `specialUse` is the correct type for a user-visible overlay that is not media,
          location, data sync or any other declared category; the subtype property is mandatory for
          that type on API 34+ and is omitted on older releases where the attribute does not exist.
        -->
        <service
            android:name=".enhanced.bubble.BubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="optional floating link bubble requested by the user" />
        </service>

        <!--
          The quick action panel the bubble opens. Not exported: only Linksi itself starts it, and
          it needs no intent filter. It is a normal focusable activity on purpose - the panel may
          only read the clipboard once it holds input focus (section 11.1).
        -->
        <activity
            android:name=".enhanced.ui.QuickPanelActivity"
            android:exported="false"
            android:label="@string/enhanced_quick_panel_title"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity="${applicationId}.quickpanel"
            android:theme="@style/Theme.Linksi.QuickPanel" />

    </application>

</manifest>
