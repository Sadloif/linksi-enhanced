<?xml version="1.0" encoding="utf-8"?>
<!--
  User-facing strings for the optional smart link detection, accessibility service and floating
  bubble module (specification sections 11, 12 and 58).

  Everything here is additive: res/values/strings.xml is untouched by this module, so a missing or
  reordered entry there can never break detection, and nothing in this file is required before the
  user turns one of the optional features on.

  The disclosure wording follows section 58: it explains why accessibility is requested and states
  plainly that the feature is optional and that standard sharing and saving work without it. It
  never claims accessibility is required.
-->
<resources>

    <!-- ── Accessibility service: shown by Android in Settings → Accessibility ── -->
    <string name="enhanced_accessibility_service_label">Linksi link detection (optional)</string>
    <string name="enhanced_accessibility_service_summary">Optional detection of likely link copy actions</string>
    <string name="enhanced_accessibility_service_description">Linksi can optionally use Android Accessibility services to detect likely link related actions and display its quick action bubble. This feature is optional. Standard sharing and saving work without it.</string>

    <!-- Full in-app disclosure (section 58). Shown before the user enables the service. -->
    <string name="enhanced_accessibility_disclosure_title">Optional accessibility assistance</string>
    <string name="enhanced_accessibility_disclosure_body">Linksi can optionally use Android Accessibility services to detect likely link related actions and display its quick action bubble. This feature is optional. Standard sharing and saving work without it.</string>
    <string name="enhanced_accessibility_disclosure_privacy">Everything is processed on this device. Linksi ignores password and other sensitive fields, never logs screen text or clipboard contents, discards anything that is not an HTTP or HTTPS link, and never uploads accessibility content.</string>
    <string name="enhanced_accessibility_disclosure_enable">Open accessibility settings</string>
    <string name="enhanced_accessibility_disclosure_later">Not now</string>

    <!-- ── Feature switches (used by whichever settings surface wires them up) ── -->
    <string name="enhanced_smart_detection_title">Smart link detection</string>
    <string name="enhanced_smart_detection_summary">Watch for likely link copy actions and offer the Linksi bubble. Optional.</string>
    <string name="enhanced_floating_bubble_title">Floating Linksi bubble</string>
    <string name="enhanced_floating_bubble_summary">Show a small Linksi bubble when a link may have been copied. Needs display over other apps.</string>
    <string name="enhanced_accessibility_assistance_title">Accessibility assistance</string>
    <string name="enhanced_accessibility_assistance_summary">Let the optional accessibility service detect likely link copy actions.</string>
    <string name="enhanced_a11y_ignore_list_title">Excluded apps</string>
    <string name="enhanced_a11y_ignore_list_summary">Detection never runs in these packages. Enter one package name per line; a trailing dot excludes the whole family.</string>
    <string name="enhanced_bubble_auto_dismiss_title">Bubble auto dismiss</string>
    <string name="enhanced_bubble_position_title">Bubble position</string>
    <string name="enhanced_bubble_size_title">Bubble size</string>

    <!-- ── Bubble ── -->
    <string name="enhanced_bubble_content_description">Linksi: a link may have been copied. Tap to open the quick panel.</string>
    <string name="enhanced_bubble_channel_name">Link bubble</string>
    <string name="enhanced_bubble_channel_description">Keeps the optional Linksi link bubble on screen while it is shown.</string>
    <string name="enhanced_bubble_notification_title">Link bubble</string>
    <string name="enhanced_bubble_notification_text">Tap the Linksi bubble to open the quick panel.</string>
    <string name="enhanced_bubble_notification_dismiss">Dismiss</string>
    <string name="enhanced_bubble_permission_title">Display over other apps</string>
    <string name="enhanced_bubble_permission_summary">The bubble needs permission to appear over other apps. This is optional and can be granted later.</string>

    <!-- ── Quick action panel ── -->
    <string name="enhanced_quick_panel_title">Linksi</string>
    <string name="enhanced_quick_panel_clean_url_label">Clean URL</string>
    <string name="enhanced_quick_panel_original_url_label">Original</string>
    <string name="enhanced_quick_panel_no_url">No valid URL detected.</string>
    <string name="enhanced_quick_panel_saved">Link saved</string>
    <string name="enhanced_quick_panel_already_saved">Link already saved</string>
    <string name="enhanced_quick_panel_save_failed">Link did not save</string>
    <string name="enhanced_quick_panel_action_save">Save</string>
    <string name="enhanced_quick_panel_action_open">Open</string>
    <string name="enhanced_quick_panel_action_share">Share</string>
    <string name="enhanced_quick_panel_action_copy">Copy</string>
    <string name="enhanced_quick_panel_action_copy_clean">Copy clean URL</string>
    <string name="enhanced_quick_panel_action_cancel">Cancel</string>
    <string name="enhanced_quick_panel_copied">Copied</string>
    <string name="enhanced_quick_panel_no_app_for_link">No app can open this link.</string>
    <string name="enhanced_quick_panel_close">Close</string>

</resources>
